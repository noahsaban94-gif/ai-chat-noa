rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // קולקציית משתמשים מורשים ונעילת מכשיר (Hardware / Device Binding)
    match /authorized_users/{userId} {
      allow read, write: if true;
    }

    // קולקציית התראות אבטחה וניסיונות חדירה
    match /security_alerts/{alertId} {
      allow read, write: if true;
    }

    // קולקציית בקשות אישור מכשירים נוספים וקודי OTP
    match /device_pairing_requests/{requestId} {
      allow read, write: if true;
    }

    // קולקציית הזמנות עבר (orders)
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // קולקציית קטלוג לוגיסטי ומק"טים (logistics_catalog)
    match /logistics_catalog/{docId} {
      allow read, write: if true;
    }

    // קולקציית לקוחות ואתרים (clients)
    match /clients/{clientId} {
      allow read, write: if true;
    }

    // קולקציית שיחות ראשית (conversations)
    match /conversations/{sessionId} {
      allow read, write: if true;

      // תת-קולקציית הודעות (messages)
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // קולקציית זיכרון נלמד ארוך-טווח (learned_knowledge)
    match /learned_knowledge/{factId} {
      allow read, write: if true;
    }

    // כללי ברירת מחדל פתוחים לקריאה וכתיבה של נתוני האפליקציה
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
